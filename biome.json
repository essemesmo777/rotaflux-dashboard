{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "lib/**",
      "worker/**",
      "build/**",
      "db/**",
      "tests/**",
      "scripts/**",
      "*.ts",
      "*.mjs",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDoubleEquals": "error"
      }
    }
  }
}
